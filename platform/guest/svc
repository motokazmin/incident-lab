#!/bin/bash
# Управление учебным сервисом. Имя и проверочный адрес задаёт сюжет в /etc/lab/service.env.
set -euo pipefail
. /etc/lab/service.env

# Убивает процесс и ждёт, пока супервизор поднимет новый и тот ответит.
bounce() {
  pkill -x "$SERVICE" || true
  sleep 0.1
  for _ in $(seq 1 50); do
    curl -fsS -o /dev/null -m 1 "http://127.0.0.1:8080$PROBE" 2>/dev/null && return 0
    sleep 0.1
  done
  echo "$SERVICE не ответил за 5 секунд, смотри svc logs" >&2
  return 1
}

case "${1:-}" in
  status)  pgrep -a "$SERVICE" || echo "$SERVICE не запущен" ;;
  logs)    exec tail -n "${2:-50}" -f "/var/log/$SERVICE.log" ;;
  restart) bounce; echo "$SERVICE перезапущен" ;;
  deploy)
    cd /srv/app
    GOFLAGS=-mod=vendor go build -o "bin/$SERVICE.new" .
    mv "bin/$SERVICE.new" "bin/$SERVICE"
    bounce
    echo "собрано и перезапущено" ;;
  *) echo "использование: svc status|logs [N]|restart|deploy"; exit 2 ;;
esac
