#!/bin/bash
# Управление учебным сервисом. Имя и проверочный адрес задаёт сюжет в /etc/lab/service.env.
set -euo pipefail
. /etc/lab/service.env

# Красит строки лога: 5xx красным, 4xx жёлтым, от 500 мс сиреневым, обычные запросы тускло,
# сообщения самого сервиса жирным, выход процесса из lab-service-start — белым на красном,
# чтобы падение не терялось среди запросов. Правила общие: цвет не должен подсказывать
# ответ сюжета.
paint() {
  awk '{
    color = 1
    if ($0 ~ / завершился: .*; перезапуск$/) {
      color = "1;97;41"
    } else if (match($0, /status=[0-9]+/)) {
      code = substr($0, RSTART + 7, 1)
      d = match($0, /dur=[^ ]+/) ? substr($0, RSTART + 4, RLENGTH - 4) : "0s"
      slow = d ~ /ms$/ ? d + 0 >= 500 : d + 0 > 0
      color = code == 5 ? 91 : code == 4 ? 33 : slow ? 95 : 2
    }
    printf "\033[%sm%s\033[0m\n", color, $0
    fflush()
  }'
}

# Убивает процесс и ждёт, пока супервизор поднимет новый и тот ответит.
bounce() {
  pkill -x "$SERVICE" || true
  sleep 0.1
  for _ in $(seq 1 50); do
    curl -fsS -o /dev/null -m 1 "http://127.0.0.1:8080$PROBE" 2>/dev/null && return 0
    sleep 0.1
  done
  echo "$SERVICE не ответил за 5 секунд, смотри svc logs" >&2
  return 1
}

case "${1:-}" in
  status)
    pgrep -a "$SERVICE" || echo "$SERVICE не запущен"
    echo "перезапусков с начала: $(cat "/run/lab/$SERVICE.restarts" 2>/dev/null || echo ?)" ;;
  logs)
    # Цвет только в терминале: в конвейере (svc logs | grep) остаётся чистый текст.
    [ -t 1 ] || exec tail -n "${2:-50}" -f "/var/log/$SERVICE.log"
    tail -n "${2:-50}" -f "/var/log/$SERVICE.log" | paint ;;
  restart) bounce; echo "$SERVICE перезапущен" ;;
  deploy)
    cd /srv/app
    GOFLAGS=-mod=vendor go build -o "bin/$SERVICE.new" .
    mv "bin/$SERVICE.new" "bin/$SERVICE"
    bounce
    echo "собрано и перезапущено" ;;
  *) echo "использование: svc status|logs [N]|restart|deploy"; exit 2 ;;
esac
