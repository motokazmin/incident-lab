#!/bin/sh
# Один запуск сервиса, вызывается супервизором из lab-service-start.
# Бинарник копируется в tmpfs: без swap его страницы нельзя вытеснить, и у лимита памяти
# ядро сразу убивает сервис, а не подчитывает его код с диска без конца. Копию делает
# этот процесс до входа в cgroup, поэтому её память в лимит сервиса не входит.
. /etc/lab/service.env
# Копия через mv: поверх бинарника, который ещё исполняется, cp упал бы с ETXTBSY.
# Без копии запустилась бы прежняя сборка, поэтому лучше выйти: супервизор запишет код в лог.
bin=/run/lab/bin/$SERVICE
mkdir -p /run/lab/bin && cp "/srv/app/bin/$SERVICE" "$bin.new" && mv "$bin.new" "$bin" || exit 1
[ -z "${MEMORY_MAX:-}" ] || echo $$ >"/sys/fs/cgroup/$SERVICE/cgroup.procs"
# Защиту от OOM супервизор не передаёт сервису.
echo 0 >/proc/self/oom_score_adj
exec "$bin"
