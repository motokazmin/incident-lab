#!/bin/sh
# Один запуск сервиса, вызывается супервизором из lab-service-start.
# Без MEMORY_MAX сервис запускается прямо из /srv/app/bin.
. /etc/lab/service.env
bin=/srv/app/bin/$SERVICE
if [ -n "${MEMORY_MAX:-}" ]; then
    # С лимитом бинарник копируется в tmpfs: без swap его страницы нельзя вытеснить, и ядро
    # сразу убивает сервис, а не подчитывает его код с диска без конца. Копию делает этот
    # процесс до входа в cgroup, поэтому её память в лимит сервиса не входит.
    # Копия через mv: поверх бинарника, который ещё исполняется, cp упал бы с ETXTBSY.
    # Без копии запустилась бы прежняя сборка, поэтому лучше выйти: супервизор запишет код в лог.
    run=/run/lab/bin/$SERVICE
    mkdir -p /run/lab/bin && cp "$bin" "$run.new" && mv "$run.new" "$run" || exit 1
    bin=$run
    echo $$ >"/sys/fs/cgroup/$SERVICE/cgroup.procs"
fi
# Защиту от OOM супервизор не передаёт сервису.
echo 0 >/proc/self/oom_score_adj
exec "$bin"
