#!/bin/bash
# Управление сервисом shop.
set -euo pipefail

# Убивает процесс и ждёт, пока супервизор поднимет новый и тот ответит.
bounce() {
  pkill -x shop || true
  sleep 0.1
  for _ in $(seq 1 50); do
    curl -fsS -o /dev/null -m 1 http://127.0.0.1:8080/products/1 2>/dev/null && return 0
    sleep 0.1
  done
  echo "shop не ответил за 5 секунд, смотри svc logs" >&2
  return 1
}

case "${1:-}" in
  status)  pgrep -a shop || echo "shop не запущен" ;;
  logs)    exec tail -n "${2:-50}" -f /var/log/shop.log ;;
  restart) bounce; echo "shop перезапущен" ;;
  deploy)
    cd /srv/app
    GOFLAGS=-mod=vendor go build -o bin/shop.new .
    mv bin/shop.new bin/shop
    bounce
    echo "собрано и перезапущено" ;;
  *) echo "использование: svc status|logs [N]|restart|deploy"; exit 2 ;;
esac
