#!/bin/sh
# Сколько горутин стоит в коде сервиса: группы профиля, в стеке которых есть кадр main.,
# кроме слушателей (main.main и профиль на :6060 стоят в net/http.ListenAndServe).
# Отсев по стеку, а не по имени кадра: обработчик в замыкании внутри main (main.main.func2.1)
# тоже считается. Горутины рантайма и соединений не считаются, поэтому после нагрузки
# у здорового сервиса здесь 0.
curl -fsS -m 5 'http://127.0.0.1:6060/debug/pprof/goroutine?debug=1' | awk '
  /^[0-9]+ @/ { flush(); n = $1; own = 0; srv = 0; next }
  /^#/ && $3 ~ /^main\./ { own = 1 }
  /^#/ && $3 ~ /^net\/http\.ListenAndServe/ { srv = 1 }
  function flush() { if (own && !srv) total += n; own = 0; srv = 0 }
  END { flush(); print total + 0 }'
